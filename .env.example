# ─── API ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_VERSION=v1

# Em produção esta variável precisa ser definida EXPLICITAMENTE.
# "*" é válido (catálogo público, sem credenciais); o que a validação
# impede é a origem ficar aberta por default, sem decisão.
# Ex. restrito: https://football-auction-game.vercel.app
CORS_ORIGIN=*

DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
MAX_IDS_PER_REQUEST=100

# Cache de borda em segundos (24h). Ver ARCHITECTURE §5.
CACHE_MAX_AGE=86400

# ─── Banco (Fase 3 em diante) ─────────────────────────────────────────
# Runtime da API: pooler Supavisor, TRANSACTION mode, porta 6543.
# Usar a conexão direta aqui quebra em produção sob concorrência.
# DATABASE_URL=postgresql://...@...pooler.supabase.com:6543/postgres

# Migrations e importação: conexão direta, porta 5432.
# NUNCA configurar esta variável na Vercel.
# DIRECT_DATABASE_URL=postgresql://...@db....supabase.co:5432/postgres

# ─── Importador Parse.bot (roda apenas local) ─────────────────────────
# PARSE_BASE_URL=
# PARSE_API_KEY=
# MAX_CALLS=10
# DELAY_MS=13000
# MIN_PACE=0
# START_PAGE=1
# DATA_DIR=./data
# EXPECTED_PAGE_SIZE=30
